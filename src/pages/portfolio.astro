              <div class="bg-[#170e0a] p-4 border-b border-[#ffd54f]/10 flex justify-between items-center relative z-10">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-[#ffd54f]/20 flex items-center justify-center text-[#ffd54f] text-sm font-bold tracking-wider">BD</div>
                  <div>
                    <h3 class="font-bold text-[#ffd54f] leading-tight tracking-wide">Botquerón Dorado</h3>
                    <p class="text-xs text-[#ffd54f]/70">Pack Hostelería</p>
                  </div>
                </div>
                <button type="button" id="toggle-menu-btn" class="text-[10px] uppercase tracking-wider font-bold px-3 py-1.5 border border-[#ffd54f]/30 rounded-full text-[#ffd54f] hover:bg-[#ffd54f]/10 transition-colors">Modificar Carta</button>

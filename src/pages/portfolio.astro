                  <div class="flex items-center border-b border-white/5 py-4"><span class="w-16 text-xs text-white/30 font-mono">19:00</span><div class="flex-1 h-px"></div></div>
                  <!-- Contenedor absoluto para los bloques de citas -->
                  <div id="agenda-blocks" class="absolute inset-0 pl-16 py-2 pointer-events-none"></div>
                </div>
              </div>
            </div>


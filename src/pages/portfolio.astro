---
import '../styles/global.css';
import FloatingWidget from './FloatingWidget.astro';
const apiKey = import.meta.env.OPENAI_API_KEY;
const baseUrl = import.meta.env.BASE_URL;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '34600000000';

// === CONFIGURACIÓN DE PORTFOLIOS ===
const proyectos = [
  {
    id: "microbarber",
    badge: "Caso de Éxito",
    title: "MicroBarber",
    description: "Nuestro sistema maestro para revolucionar la gestión de citas e integrarse con WhatsApp. Nació para optimizar agendas complejas como barberías o salones, pero su modularidad al conectarse a nuestro agente de IA se adapta a clínicas, consultorías y reservas de cualquier negocio.",
    features: [
      {
        title: "Control Total",
        description: "Mira todas tus citas unificadas en un tablero limpio y rápido. Podrás mover, cancelar o gestionar tiempos de servicio con un solo clic.",
        image: "/foto_dashboard_jcbarber.png",
        alt: "Demo de interfaz y calendario de MicroBarber"
      },
      {
        title: "La IA en WhatsApp",
        description: "Tus clientes piden cita enviando un simple mensaje. Nuestro bot ve la disponibilidad en tiempo real gracias al calendario inteligente.",
        image: "/calendario_jcbarber.png",
        alt: "Demo de bot de WhatsApp MicroBarber y conexión de calendario"
      }
    ]
  }
];
---

<!DOCTYPE html>
<html lang="es" class="bg-slate-50 text-ink scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Portfolio y Demos | Botquerón</title>
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>

<body class="selection:bg-primary/20 selection:text-primary font-body antialiased text-ink bg-[#F8FAFC]">

  <!-- Navbar -->
  <header class="fixed top-0 w-full z-50 glass-panel border-b border-white/20 transition-all duration-300">
    <div class="w-full max-w-[90rem] mx-auto px-4 md:px-8 h-20 flex items-center justify-between relative">
      <a href="#" class="font-display font-bold text-3xl md:text-4xl tracking-tight text-primary flex items-center">
        Botquerón
      </a>

      <!-- Menú pantalla ordenador -->
      <nav class="hidden md:flex items-center gap-8 font-semibold text-sm">
        <a href={baseUrl} class="text-ink-light hover:text-primary transition-colors">Inicio</a>
        <a href={`${baseUrl}#planes`} class="text-ink-light hover:text-primary transition-colors">Planes</a>
        <a href={`${baseUrl}portfolio/#demos`} class="text-ink-light hover:text-primary transition-colors border border-orange-500 px-2 py-0.5 rounded">Prueba una demo</a>
        <a href={`${baseUrl}#contacto`} class="btn-primary px-6 py-2.5 text-sm font-bold tracking-wide">Empezar ahora</a>
      </nav>

      <!-- Botón hamburguesa: visible solo en móvil -->
      <button id="menu-toggle" class="md:hidden flex items-center justify-center w-10 h-10" aria-label="Abrir menú" aria-expanded="false">
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Menú móvil: oculto por defecto, se despliega debajo del header -->
      <nav id="mobile-menu" style="width: 240px !important; max-width: 240px !important; right: 4px !important; left: auto !important;" class="hidden md:hidden flex flex-col gap-1 font-bold text-right text-base absolute top-full bg-white shadow-xl px-4 py-2 rounded-xl z-50">
        <a href={baseUrl} class="bg-sky-100 py-0.5 text-ink-light hover:text-primary transition-colors">Inicio</a>
        <a href={`${baseUrl}#planes`} class="bg-sky-100 py-0.5 text-ink-light hover:text-primary transition-colors">Planes</a>
        <a href={`${baseUrl}portfolio/#demos`} class="bg-sky-100 py-0.5 text-ink-light hover:text-primary transition-colors">Prueba una demo</a>
        <a href={`${baseUrl}#contacto`} class="btn-primary text-center px-4 py-2 mt-1.5 text-sm font-bold tracking-wide">Empezar ahora</a>
      </nav>

      <script>
        const toggleBtn = document.getElementById("menu-toggle");
        const mobileMenu = document.getElementById("mobile-menu");
        const iconOpen = document.getElementById("icon-open");
        const iconClose = document.getElementById("icon-close");

        toggleBtn?.addEventListener("click", () => {
          const isOpen = !mobileMenu?.classList.contains("hidden");
          mobileMenu?.classList.toggle("hidden");
          iconOpen?.classList.toggle("hidden");
          iconClose?.classList.toggle("hidden");
          toggleBtn.setAttribute("aria-expanded", String(!isOpen));
        });

        // Cierra el menú al tocar un link
        mobileMenu?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            toggleBtn?.setAttribute("aria-expanded", "false");
          });
        });
      </script>

    </div>
  </header>


  <FloatingWidget baseUrl={baseUrl} />


  <!-- Portfolio Content Iteration -->
  <main class="flex-1 flex flex-col pt-20">
    
    {proyectos.map((proyecto, pIndex) => (

      <div class="flex flex-col" id={proyecto.id}>

        <!-- Header del proyecto -->
        <section class="py-12 md:py-32 px-4 sm:px-6 flex flex-col items-center bg-white text-center border-b border-slate-100 relative overflow-hidden w-full max-w-full">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full pointer-events-none">
            <div class="absolute top-[20%] left-[20%] w-[40%] h-[60%] rounded-full bg-primary/5 blur-[100px]">
            </div>
          </div>
          <div class="relative z-10 max-w-4xl mx-auto w-full px-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-secondary/10 text-secondary font-bold text-xs tracking-wide uppercase mb-6 border border-secondary/20">
              {proyecto.badge}
            </div>
            <h1 class="font-display font-bold text-3xl sm:text-5xl md:text-6xl lg:text-7xl mb-6 text-ink tracking-tight break-words">
              {proyecto.title}
            </h1>
            <p class="text-base sm:text-lg md:text-xl text-ink-light max-w-3xl mx-auto leading-relaxed break-words w-full">
              {proyecto.description}
            </p>
          </div>
        </section>

        <!-- Gallery / Demo Features -->
        <section class="py-20 md:py-32 px-6 bg-[#F8FAFC]">
          <div class="max-w-6xl mx-auto flex flex-col gap-24 lg:gap-32">
            {proyecto.features.map((feature, fIndex) => {
              const isEven = fIndex % 2 === 0;
              return (
                <div class={`flex flex-col ${isEven ? 'lg:flex-row' : 'lg:flex-row-reverse'} gap-12 lg:gap-16 items-center`}>
                  <div class="flex-1 w-full lg:w-1/2">
                    <figure class="relative rounded-3xl overflow-hidden soft-shadow border border-slate-200/60 bg-white group cursor-zoom-in">
                      <div class="absolute top-0 inset-x-0 h-10 bg-slate-50/80 backdrop-blur-md border-b border-slate-200 flex items-center px-4 gap-2 z-10">
                        <div class="flex gap-1.5">
                          <div class="w-3 h-3 rounded-full bg-red-400"></div>
                          <div class="w-3 h-3 rounded-full bg-amber-400"></div>
                          <div class="w-3 h-3 rounded-full bg-green-400"></div>
                        </div>
                      </div>
                      <div class="overflow-hidden pt-10">
                        <img src={feature.image} alt={feature.alt} class="zoomable w-full h-auto object-cover transform group-hover:scale-105 transition-transform duration-700 ease-in-out" />
                      </div>
                      <div class="absolute inset-0 bg-ink/0 group-hover:bg-ink/5 transition-colors duration-300 pointer-events-none z-20"></div>
                    </figure>
                  </div>
                  <div class="flex-1 w-full lg:w-1/2 flex flex-col justify-center">
                    <div class="w-12 h-12 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6">
                      <span class="font-display font-bold text-xl">{fIndex + 1}</span>
                    </div>
                    <h3 class="font-display font-bold text-3xl mb-4 text-ink">{feature.title}</h3>
                    <p class="text-lg text-ink-light leading-relaxed">{feature.description}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </section>

      </div>
    ))}

    <!-- Demos Interactivas -->
    <section id="demos" class="py-24 px-6 bg-white border-t border-slate-100" id="demos">
      <div class="max-w-6xl mx-auto flex flex-col gap-16">
        <div class="text-center">

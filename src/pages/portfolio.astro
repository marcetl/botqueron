                </div>
                <div class="flex gap-2 text-xs font-medium text-white/70">
                  <span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-white"></div> Álex</span>
                  <span class="flex items-center gap-1"><div class="w-2 h-2 rounded-full bg-slate-500"></div> Laura</span>
                </div>
              </div>
              <!-- Este contenedor es el que absorbe las citas y permite scroll interno -->
              <div class="flex-1 min-h-0 bg-[#1a1a1a] rounded-2xl border border-white/5 p-4 overflow-y-auto scrollbar-thin relative">
                <div class="flex flex-col relative" id="agenda-grid">
                  <!-- Horas del día base -->
                  <div class="flex items-center border-b border-white/5 py-4"><span class="w-16 text-xs text-white/30 font-mono">10:00</span><div class="flex-1 h-px"></div></div>
                  <div class="flex items-center border-b border-white/5 py-4"><span class="w-16 text-xs text-white/30 font-mono">11:00</span><div class="flex-1 h-px"></div></div>

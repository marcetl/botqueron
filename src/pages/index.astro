  <!-- Demo Video Modal -->
  <div id="demo-modal" class="fixed inset-0 z-[200] hidden items-center justify-center p-4 bg-ink/80 backdrop-blur-sm" role="dialog" aria-modal="true" aria-labelledby="demo-modal-title">
    <div class="relative w-full max-w-4xl bg-ink rounded-3xl overflow-hidden shadow-2xl ring-1 ring-white/10">
      <div class="flex items-center justify-between px-5 py-4 border-b border-white/10">
        <h3 id="demo-modal-title" class="font-display font-bold text-white text-lg">Demo</h3>
        <button id="demo-close" type="button" aria-label="Cerrar" class="w-9 h-9 inline-flex items-center justify-center rounded-full bg-white/10 hover:bg-white/20 text-white transition-colors">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 6l12 12M6 18L18 6"/></svg>
        </button>
      </div>
      <div class="aspect-video bg-black flex items-center justify-center">
        <video id="demo-video" class="w-full h-full" controls playsinline preload="metadata"></video>
        <div id="demo-fallback" class="hidden text-center text-slate-300 px-6">
          <p class="font-display font-bold text-xl text-white mb-2">Vídeo en preparación</p>
          <p class="text-sm">Estamos grabando la demo de este pack. ¡Vuelve pronto!</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Text Rotation Animation
    const rotatingText = document.getElementById('rotating-text');
    if (rotatingText) {
      const words = ['Negocio.', 'Barbería.', 'Agenda.', 'Peluquería.', 'Veterinaria.', 'Salón de belleza.'];
      let wordIndex = 0;
      
      setInterval(() => {
        rotatingText.classList.add('opacity-0');
        setTimeout(() => {
          wordIndex = (wordIndex + 1) % words.length;
          rotatingText.textContent = words[wordIndex];
          rotatingText.classList.remove('opacity-0');
        }, 500);
      }, 3000);
    }

    // Slide-up animations
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: "0px 0px -50px 0px" });

    document.querySelectorAll('.slide-up, .slide-left, .slide-right').forEach((el) => {
      observer.observe(el);
    });

    // Form Submission
    const contactForm = document.getElementById('contact-form');
    const submitBtn = document.getElementById('submit-btn');
    const formMessage = document.getElementById('form-message');

    if (contactForm && submitBtn && formMessage) {
      contactForm.addEventListener('submit', async (e) => {
        e.preventDefault();
       
        const N8N_WEBHOOK_URL = import.meta.env.PUBLIC_N8N_WEBHOOK_URL;

        const telefonoInput = document.getElementById('telefono') as HTMLInputElement | null;
        if (!telefonoInput) return;
        const telefonoVal = telefonoInput.value.trim(); // Ya sabemos que no es null

        if (!/^(\+34|0)[0-9\s\-]{7,13}$/.test(telefonoVal)) {
          formMessage.textContent = '⚠️ Introduce un número de teléfono válido.';
          formMessage.className = 'p-4 rounded-xl text-center font-bold mt-4 text-sm bg-red-50 text-red-600 border border-red-100';
          return;
        }

        if (!N8N_WEBHOOK_URL || N8N_WEBHOOK_URL === 'TU_URL_DE_WEBHOOK_N8N_AQUI') {
          console.warn('Falta configurar la URL de n8n.');
          formMessage.textContent = '⚠️ Error: Falta configurar el destino del formulario.';
          formMessage.className = 'p-4 rounded-xl text-center font-bold mt-4 text-sm bg-red-50 text-red-600 border border-red-100';
          return;
        }

        const formData = new FormData(contactForm as HTMLFormElement);
        const data = Object.fromEntries(formData.entries());

        (submitBtn as HTMLButtonElement).disabled = true;
        submitBtn.textContent = 'Enviando...';

        try {
          const response = await fetch(N8N_WEBHOOK_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });

          if (response.ok) {
            formMessage.textContent = '✅ ¡Recibido! Te contactaremos pronto.';
            formMessage.className = 'p-4 rounded-xl text-center font-bold mt-4 text-sm bg-emerald-50 text-emerald-600 border border-emerald-100';
            (contactForm as HTMLFormElement).reset();
          } else {
            throw new Error('Error en el servidor');
          }
        } catch (error) {
          formMessage.textContent = '❌ Algo ha fallado. Inténtalo de nuevo.';
          formMessage.className = 'p-4 rounded-xl text-center font-bold mt-4 text-sm bg-red-50 text-red-600 border border-red-100';
        } finally {
          (submitBtn as HTMLButtonElement).disabled = false;
          submitBtn.textContent = 'Enviar Petición';
        }
      });
    }
    // Demo Video Modal
    const demoModal = document.getElementById('demo-modal');
    const demoVideo = document.getElementById('demo-video') as HTMLVideoElement | null;
    const demoFallback = document.getElementById('demo-fallback');
    const demoTitle = document.getElementById('demo-modal-title');
    const demoClose = document.getElementById('demo-close');

    const openDemo = (src: string, title: string) => {
      if (!demoModal || !demoVideo || !demoFallback || !demoTitle) return;
      demoTitle.textContent = title || 'Demo';
      if (src) {
        demoVideo.src = src;
        demoVideo.classList.remove('hidden');
        demoFallback.classList.add('hidden');
        demoVideo.play().catch((err) => {demoFallback.classList.remove('hidden');console.error('Video play error:', err);});        
      } else {
        demoVideo.removeAttribute('src');
        demoVideo.load();
        demoVideo.classList.add('hidden');
        demoFallback.classList.remove('hidden');
      }
      demoModal.classList.remove('hidden');
      demoModal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };

    const closeDemo = () => {
      if (!demoModal || !demoVideo) return;
      demoVideo.pause();
      demoVideo.removeAttribute('src');
      demoVideo.load();
      demoModal.classList.add('hidden');
      demoModal.classList.remove('flex');
      document.body.style.overflow = '';
    };

    document.querySelectorAll<HTMLButtonElement>('.demo-trigger').forEach((btn) => {
      btn.addEventListener('click', () => {
        const src = btn.getAttribute('data-demo-video') ?? '';
        const title = btn.getAttribute('data-demo-title') ?? 'Demo';
        openDemo(src, title);
      });
    });

    if (demoClose) demoClose.addEventListener('click', closeDemo);
    if (demoModal) {
      demoModal.addEventListener('click', (e) => {
        if (e.target === demoModal) closeDemo();
      });
    }
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && demoModal && !demoModal.classList.contains('hidden')) closeDemo();
    });

    // Scroll handling unificado: espetos flotantes + header inteligente
    // Un único listener passive + rAF en vez de dos listeners independientes,
    // para reducir el trabajo en el hilo principal durante el scroll.
    const espetoLeft = document.getElementById('espeto-left');
    const espetoRight = document.getElementById('espeto-right');
    const header = document.querySelector('header');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let lastScrollY = window.scrollY;
    let ticking = false;

    const onScroll = () => {
      const scrollY = window.scrollY;

      if (espetoLeft && espetoRight && !prefersReducedMotion) {
        // Aparecen después del hero (aprox 400px) y desaparecen al bajar mucho (aprox 1800px)
        if (scrollY > 400 && scrollY < 1800) {
          espetoLeft.classList.remove('-translate-x-full');
          espetoRight.classList.remove('translate-x-full');
        } else {
          espetoLeft.classList.add('-translate-x-full');
          espetoRight.classList.add('translate-x-full');
        }
      }

      if (header) {
        if (scrollY > lastScrollY && scrollY > 100) {
          header.classList.add('-translate-y-full', 'opacity-0');
        } else {
          header.classList.remove('-translate-y-full', 'opacity-0');
        }
      }

      lastScrollY = scrollY;
      ticking = false;
    };

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(onScroll);
        ticking = true;
      }
    }, { passive: true });
  </script>
</body>

---
import '../styles/global.css';
const baseUrl = import.meta.env.BASE_URL;
const whatsappNumber = import.meta.env.PUBLIC_WHATSAPP_NUMBER ?? '34600000000';
---

<!DOCTYPE html>
<html lang="es" class="bg-canvas text-ink scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Botquerón | IA con acento local al servicio de tu negocio</title>
  <meta name="description" content="Botquerón automatiza la atención al cliente y las reservas utilizando mensajería: barberías, hostelería, clínicas, peluquerías y despachos.">
  <meta name="keywords" content="inteligencia artificial, autonomos, IA para pymes, automatizacion WhatsApp, chatbot reservas, asistente virtual negocio, Malaga, hostelería, clínica, veterinaria, peluquería, barbería, asesoría, manicura, botqueron">
  <meta name="author" content="Botquerón">
  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://botqueron.com/">
  <meta name="theme-color" content="#2563EB">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://botqueron.com/">
  <meta property="og:description" content="Automatiza la atención al cliente y las reservas de tu negocio con IA. Menos pantallas, más tiempo para tu negocio.">
  <meta property="og:image" content="https://botqueron.com/og-image.jpg">

  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content="https://botqueron.com/">
  <meta property="twitter:title" content="Botquerón | IA con acento local al servicio de tu negocio">
  <meta property="twitter:description" content="Automatiza la atención al cliente, reservas y WhatsApp de tu negocio con soluciones de Inteligencia Artificial pensadas para tu negocio.">
  <meta property="twitter:image" content="https://botqueron.com/og-image.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;600;700;800&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Preload del poster del hero para mejorar el LCP mientras carga el vídeo -->
  <link rel="preload" as="image" href="/video-poster.png" fetchpriority="high">

  <!-- Datos estructurados para SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Botquerón",
    "url": "https://botqueron.com/",
    "logo": "https://botqueron.com/og-image.jpg",
    "description": "Asistente IA para automatizar la atención al cliente y las reservas de tu negocio. Menos pantallas, más tiempo para tu negocio.",
    "areaServed": "ES",
    "address": { "@type": "PostalAddress", "addressLocality": "Málaga", "addressCountry": "ES" },
    "sameAs": []
  })} />
  <style is:global>
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>
<body class="selection:bg-primary/20 selection:text-primary font-body antialiased text-ink bg-[#F8FAFC]">

  <!-- Navbar -->
  <header class="fixed top-0 w-full z-50 glass-panel border-b border-white/20 transition-all duration-300">
    <div class="w-full max-w-[90rem] mx-auto px-4 md:px-8 h-20 flex items-center justify-between">
      <a href="#" class="font-display font-bold text-3xl md:text-4xl tracking-tight text-primary flex items-center">
        Botquerón
      </a>
      
      <nav class="hidden md:flex items-center gap-8 font-semibold text-sm">
        <a href={`${baseUrl}#soluciones`} class="text-ink-light hover:text-primary transition-colors">Soluciones</a>
        <a href={`${baseUrl}#como-funciona`} class="text-ink-light hover:text-primary transition-colors">Cómo funciona</a>
        <a href={`${baseUrl}#enlaces`} class="text-ink-light hover:text-primary transition-colors">Versiones</a>
        <a href={`${baseUrl}#planes`} class="text-ink-light hover:text-primary transition-colors">Planes</a>
        <a href={`${baseUrl}portfolio/`} class="text-ink-light hover:text-primary transition-colors">Conoce nuestro trabajo</a>
        <a href={`${baseUrl}#contacto`} class="btn-primary px-6 py-2.5 text-sm font-bold tracking-wide">Empezar ahora</a>
      </nav>
      
      <a href="#contacto" class="md:hidden btn-primary px-5 py-2 text-xs font-bold tracking-wide">Contactar</a>
    </div>
  </header>

  <!-- Floating Espetos -->
  <div id="espeto-left" class="fixed top-[30%] -left-8 z-40 transform transition-transform duration-1000 ease-in-out pointer-events-none drop-shadow-2xl opacity-90 hidden md:block">
    <svg width="200" height="260" viewBox="0 0 100 150" class="animate-float">
      <!-- Vara -->
      <line x1="10" y1="140" x2="90" y2="10" stroke="#b45309" stroke-width="4" stroke-linecap="round"/>
      <!-- Fuego base -->
      <path d="M0 140 Q 20 120 40 140 Q 20 160 0 140" fill="#ea580c" opacity="0.6"/>
      <path d="M10 140 Q 20 130 30 140 Q 20 150 10 140" fill="#fef08a" opacity="0.8"/>
      <!-- Sardinas -->
      <g transform="translate(30, 95) rotate(-35)"><path d="M0,0 C10,-12 35,-6 45,0 C35,6 10,12 0,0" fill="#cbd5e1" stroke="#64748b"/><circle cx="8" cy="-2" r="1.5" fill="#0f172a"/><path d="M40,-3 L48,-8 L43,0 L48,8 L40,3 Z" fill="#cbd5e1"/></g>
      <g transform="translate(45, 65) rotate(-35)"><path d="M0,0 C10,-12 35,-6 45,0 C35,6 10,12 0,0" fill="#cbd5e1" stroke="#64748b"/><circle cx="8" cy="-2" r="1.5" fill="#0f172a"/><path d="M40,-3 L48,-8 L43,0 L48,8 L40,3 Z" fill="#cbd5e1"/></g>
      <g transform="translate(60, 35) rotate(-35)"><path d="M0,0 C10,-12 35,-6 45,0 C35,6 10,12 0,0" fill="#cbd5e1" stroke="#64748b"/><circle cx="8" cy="-2" r="1.5" fill="#0f172a"/><path d="M40,-3 L48,-8 L43,0 L48,8 L40,3 Z" fill="#cbd5e1"/></g>
    </svg>
  </div>

  <div id="espeto-right" class="fixed top-[50%] -right-8 z-40 transform transition-transform duration-1000 ease-in-out pointer-events-none drop-shadow-2xl opacity-90 hidden md:block">
    <svg width="200" height="260" viewBox="0 0 100 150" class="animate-float" style="animation-delay: 2s;">
      <!-- Vara -->
      <line x1="90" y1="140" x2="10" y2="10" stroke="#b45309" stroke-width="4" stroke-linecap="round"/>
      <!-- Fuego base -->
      <path d="M100 140 Q 80 120 60 140 Q 80 160 100 140" fill="#ea580c" opacity="0.6"/>
      <path d="M90 140 Q 80 130 70 140 Q 80 150 90 140" fill="#fef08a" opacity="0.8"/>
      <!-- Sardinas -->
      <g transform="translate(70, 95) rotate(-145)"><path d="M0,0 C10,-12 35,-6 45,0 C35,6 10,12 0,0" fill="#cbd5e1" stroke="#64748b"/><circle cx="8" cy="-2" r="1.5" fill="#0f172a"/><path d="M40,-3 L48,-8 L43,0 L48,8 L40,3 Z" fill="#cbd5e1"/></g>
      <g transform="translate(55, 65) rotate(-145)"><path d="M0,0 C10,-12 35,-6 45,0 C35,6 10,12 0,0" fill="#cbd5e1" stroke="#64748b"/><circle cx="8" cy="-2" r="1.5" fill="#0f172a"/><path d="M40,-3 L48,-8 L43,0 L48,8 L40,3 Z" fill="#cbd5e1"/></g>
      <g transform="translate(40, 35) rotate(-145)"><path d="M0,0 C10,-12 35,-6 45,0 C35,6 10,12 0,0" fill="#cbd5e1" stroke="#64748b"/><circle cx="8" cy="-2" r="1.5" fill="#0f172a"/><path d="M40,-3 L48,-8 L43,0 L48,8 L40,3 Z" fill="#cbd5e1"/></g>
    </svg>
  </div>

  <main>
    <!-- HERO SECTION -->
    <section id="video" class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden flex items-center justify-center min-h-[85vh]">
      <!-- Background Video -->
      <div class="absolute inset-0 w-full h-full z-0">
        <video
          autoplay
          loop
          muted
          playsinline
          preload="metadata"
          poster="/video-poster.png"
          class="w-full h-full object-cover"
        >
          <source src="/video_botqueron.mp4" type="video/mp4" />
        </video>
        <!-- Overlay sutil sin difuminado para ver el vídeo 100% nítido -->
        <div class="absolute inset-0 bg-ink/40"></div>
      </div>

      <div class="max-w-4xl mx-auto px-6 relative z-10 text-center slide-up is-visible">
        <h1 class="font-display font-bold text-4xl md:text-6xl lg:text-7xl leading-[1.1] tracking-tight mb-8 text-balance text-white">
          Automatiza tu<br/>
          <span id="rotating-text" class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-orange-400 drop-shadow-sm inline-block min-w-[280px] transition-opacity duration-500">Negocio.</span>
        </h1>
        <p class="text-lg md:text-xl text-white/80 mb-10 max-w-2xl mx-auto leading-relaxed text-balance">
          El empleado digital para tu negocio: responde a tus clientes, agenda citas y filtra consultas 24/7. Recupera horas cada semana gracias a la IA.
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-4">
          <a href="#planes" class="btn-primary px-8 py-4 font-bold text-center text-sm md:text-base w-full sm:w-auto flex items-center justify-center gap-2 border border-primary-dark">
            Ver los planes
          </a>
          <a href="#soluciones" class="px-8 py-4 font-bold text-center text-sm md:text-base w-full sm:w-auto text-white hover:bg-white/10 transition-colors flex items-center justify-center rounded-xl border border-white/20 backdrop-blur-sm">
            Descubrir más →
          </a>
        </div>

        <!-- Barra de confianza: señales clave para autónomos/pymes que evalúan contratar software -->
        <div class="mt-12 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-white/70 text-xs md:text-sm font-semibold uppercase tracking-wide">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 2l7 3v6c0 5-3.5 8.5-7 10-3.5-1.5-7-5-7-10V5l7-3z"/></svg>
            Cumplimiento RGPD
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            Sin permanencia
          </span>
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-secondary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 21c0-3.87-3.58-7-8-7s-8 3.13-8 7"/><circle cx="12" cy="7" r="4"/></svg>
            Soporte humano en español
          </span>
        </div>
      </div>
    </section>

    <!-- SOLUCIONES SECTION -->
    <section id="soluciones" class="py-24 bg-white relative">
      <div class="max-w-7xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16 slide-up">
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-4 text-ink">Nada de estrés.<br>Todo controlado.</h2>
          <p class="text-lg text-ink-light">Ya seas autónomo o tengas un pequeño equipo, tu IA se encarga de cada interacción con el cliente mientras tú te centras en lo que realmente importa.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          <!-- 01 Boquerón (Pez) -->
          <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100 soft-shadow slide-up transition-transform duration-300 hover:-translate-y-2">
            <div class="w-14 h-14 rounded-2xl bg-primary/10 text-primary flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6.5 12c.94-3.46 4.94-6 8.5-6 1.18 0 2.93-.28 3.69-1.22A2.43 2.43 0 0 0 19 6c0 1.25.5 2.4 1.5 3-1 .6-1.5 1.75-1.5 3a2.43 2.43 0 0 0-.31 1.22c-.76-.94-2.51-1.22-3.69-1.22-3.56 0-7.56-2.54-8.5-6Z" /><path d="M2 16s1.5-1 3-1"/><path d="M2 12s1.5-1 3-1"/><path d="M2 8s1.5-1 3-1"/></svg>
            </div>
            <h3 class="font-display font-bold text-xl mb-3 text-ink">Ágil como un Botquerón</h3>
            <p class="text-ink-light leading-relaxed">Tus clientes nunca esperan. El sistema entiende de qué le hablan, resuelve dudas y mantiene un tono natural al instante.</p>
          </div>

          <!-- 02 Sol (Málaga) -->
          <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100 soft-shadow slide-up transition-transform duration-300 hover:-translate-y-2" style="transition-delay: 100ms;">
            <div class="w-14 h-14 rounded-2xl bg-amber-100 text-amber-500 flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
            </div>
            <h3 class="font-display font-bold text-xl mb-3 text-ink">Agenda Inteligente</h3>
            <p class="text-ink-light leading-relaxed">Sincronización total con tu calendario. Si hay un hueco libre, el sistema lo llena solo. Mínimo margen de error y cero cruces.</p>
          </div>

          <!-- 03 Espeto (Fuego) -->
          <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100 soft-shadow slide-up transition-transform duration-300 hover:-translate-y-2" style="transition-delay: 200ms;">
            <div class="w-14 h-14 rounded-2xl bg-secondary/10 text-secondary flex items-center justify-center mb-6">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>
            </div>
            <h3 class="font-display font-bold text-xl mb-3 text-ink">Crecimiento al Calor Local</h3>
            <p class="text-ink-light leading-relaxed">Diseñado para negocios reales y cercanos. Gana todas las batallas de eficiencia y factura más sin perder tu propio estilo.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CÓMO FUNCIONA SECTION -->
    <section id="como-funciona" class="py-24 bg-[#F8FAFC] [content-visibility:auto] [contain-intrinsic-size:1px_700px]">
      <div class="max-w-6xl mx-auto px-6">
        <div class="text-center max-w-2xl mx-auto mb-16 slide-up">
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-4 text-ink">De cero a automatizado<br>en 3 pasos</h2>
          <p class="text-lg text-ink-light">Sin conocimientos técnicos. Nosotros montamos tu asistente, tú solo lo apruebas.</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 relative">
          <div class="slide-up">
            <div class="font-display font-black text-5xl text-primary/20 mb-4">01</div>
            <h3 class="font-display font-bold text-xl mb-3 text-ink">Cuéntanos tu negocio</h3>
            <p class="text-ink-light leading-relaxed">Rellenas un formulario de 2 minutos con tus servicios, precios y horarios. Nada de reuniones eternas.</p>
          </div>
          <div class="slide-up" style="transition-delay: 100ms;">
            <div class="font-display font-black text-5xl text-primary/20 mb-4">02</div>
            <h3 class="font-display font-bold text-xl mb-3 text-ink">Entrenamos tu IA</h3>
            <p class="text-ink-light leading-relaxed">En 48-72 horas tu asistente está configurado, conectado a tu WhatsApp y a tu calendario.</p>
          </div>
          <div class="slide-up" style="transition-delay: 200ms;">
            <div class="font-display font-black text-5xl text-primary/20 mb-4">03</div>
            <h3 class="font-display font-bold text-xl mb-3 text-ink">Tú recibes clientes</h3>
            <p class="text-ink-light leading-relaxed">Revisa la agenda cuando quieras. El resto lo lleva tu empleado digital, 24 horas al día.</p>
          </div>
        </div>
      </div>
    </section>



    <!-- ENLACES SECTION -->
    <section id="enlaces" class="absolute inset-0 opacity-80 bg-gradient-to-br from-blue-700 to-primary">
      <div style="max-width: 1280px; margin: 0px auto; padding: 0 1.5rem;">
        <!-- Encabezado -->
        <div style="text-align: center; margin-bottom: 2.5rem; opacity: 1; transform: none;">
          <p style="font-size: 0.8rem; font-weight: 600; color: rgb(0, 255, 212); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 0.75rem;">Para tu sector</p>
          <h2 style="font-family: &quot;Cormorant Garamond&quot;, serif; font-size: clamp(1.75rem, 3vw, 2.5rem); font-weight: 600; color: rgb(247, 248, 248); line-height: 1.2;">
            Cualquier negocio que viva de las citas. 
            <span style="color: rgb(0, 255, 212); font-style: italic;">Cualquiera.</span>
          </h2>
        </div>

        <div class="landing-industries-grid" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; max-width: 1100px; margin: 0 auto;">
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Peluquerías">💈</span>Peluquerías
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Barberías">🪒</span>Barberías
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Clínicas">🏥</span>Clínicas
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Fisioterapia">🦴</span>Fisioterapia
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Psicología">🧠</span>Psicología
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(35, 37, 42); background: rgb(22, 23, 24); cursor: default; font-size: 0.9rem; color: rgb(208, 214, 224); font-weight: 500; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Odontología">🦷</span>Odontología
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Estética y Spa">💅</span>Estética y Spa
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Entrenamiento">🏋️</span>Entrenamiento
          </div>
          <div style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.625rem 1.125rem; border-radius: 6px; border: 1px solid rgb(160, 168, 185); background: rgb(0, 0, 0); cursor: default; font-size: 0.9rem; color: rgb(255, 255, 255); font-weight: 700; transition: border-color 0.2s, background 0.2s; user-select: none;">
            <span style="font-size: 1.1rem; line-height: 1;" role="img" aria-label="Yoga y Pilates">🧘</span>Yoga y Pilates
          </div>

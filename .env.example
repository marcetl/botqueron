# === BOTQUERÓN — Variables de Entorno ===
# Copia este fichero como .env y rellena los valores reales.
# Las variables con prefijo PUBLIC_ son visibles en el navegador (cliente).

# URL del webhook de n8n que recibe los leads del formulario de contacto
PUBLIC_N8N_WEBHOOK_URL=https://n8n.tudominio.com/webhook/botqueron-lead

# Número de WhatsApp para el botón directo (formato internacional sin espacios ni +)
PUBLIC_WHATSAPP_NUMBER=34600000000

# Clave de API para las demos interactivas (OpenRouter Gemini)
OPENROUTER_API_KEY=sk-or-v1-tu-clave-aqui
